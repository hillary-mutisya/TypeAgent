{
  "name": "stagehand-typeagent-prototype",
  "version": "0.0.1",
  "private": true,
  "description": "Prototype Stagehand browser automation using TypeAgent model configuration.",
  "homepage": "https://github.com/microsoft/TypeAgent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/TypeAgent.git",
    "directory": "ts/examples/stagehand"
  },
  "license": "MIT",
  "author": "Microsoft",
  "type": "module",
  "bin": {
    "stagehand-typeagent": "./dist/src/run.js"
  },
  "scripts": {
    "build": "npm run tsc",
    "clean": "rimraf --glob dist *.tsbuildinfo *.done.build.log",
    "jest-esm": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "prettier": "prettier --check . --ignore-path ../../.prettierignore",
    "prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "start": "node ./dist/src/run.js",
    "test": "npm run test:local",
    "test:local": "pnpm run jest-esm --testPathPattern=\".*[.]spec[.]js\"",
    "tsc": "tsc -b"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@typeagent/aiclient": "workspace:*",
    "@typeagent/config": "workspace:*",
    "typechat": "^0.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.4.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
